# From valid live set counts sa-sb, one more set won by y leaves valid counts.
law set_added_ok:
  for y: S.Side
  for sa: Nat
  for sb: Nat
  {Imp(Bool.and(MInvC(sa, sb), MLive(sa, sb)), MInvC(Laws.Rule.count(Laws.Rule.same(y, S.A{}), sa), Laws.Rule.count(Laws.Rule.same(y, S.B{}), sb))) == True{} : Bool}

def set_added_ok(y, sa, sb):
  match y:
    case S.A{}:
      match sa:
        case 0n:
          match sb:
            case 0n:
              {==}
            case 1n+sb_1:
              match sb_1:
                case 0n:
                  {==}
                case 1n+sb_1_2:
                  match sb_1_2:
                    case 0n:
                      {==}
                    case 1n+sb_1_2_3:
                      {==}
        case 1n+sa_1:
          match sa_1:
            case 0n:
              match sb:
                case 0n:
                  {==}
                case 1n+sb_1:
                  match sb_1:
                    case 0n:
                      {==}
                    case 1n+sb_1_2:
                      match sb_1_2:
                        case 0n:
                          {==}
                        case 1n+sb_1_2_3:
                          {==}
            case 1n+sa_1_2:
              match sa_1_2:
