# Bend build output (native binaries, emitted C/JS); only .bend sources are tracked
engine/*
!engine/*.bend
# Node
node_modules/
# Results: only published runs are committed (force-add them: git add -f)
results/*.csv
# Compiled simulator binaries
build/
# Downloaded Tennis Abstract files (prep/fetch.ts); only the trimmed extracts in data/raw/ are committed
data/downloads/
# Results page build output; site/src/data/results.json is the latest run, committed only when published (git add -f)
site/dist/
site/.astro/
site/src/data/results.json
